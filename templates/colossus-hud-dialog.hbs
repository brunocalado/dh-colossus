<div id="dh-colossus-hud-root">
  <div class="dh-colossus-info-banner">
    <strong>{{colossusName}}</strong>
  </div>

  <div class="dh-colossus-hud-actions">
    <button type="button" class="dh-colossus-btn" data-action="openSheet">
      <i class="fas fa-scroll"></i> Open
    </button>
    <button type="button" class="dh-colossus-btn" data-action="viewSegments">
      <i class="fas fa-project-diagram"></i> View Segments
    </button>
  </div>
</div>
