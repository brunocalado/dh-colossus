<section class="colossus-manager-content">
  <div class="manager-header">
    <button type="button" data-action="createColossus">
      <i class="fas fa-plus"></i> Create Colossus
    </button>
  </div>

  {{#if colossi.length}}
  <ol class="colossus-list">
    {{#each colossi}}
    <li class="colossus-entry" data-colossus-id="{{this.id}}">
      <img src="{{this.img}}" alt="{{this.name}}" width="36" height="36" />
      <span class="colossus-name">{{this.name}}</span>
      <div class="colossus-actions">
        <button type="button" data-action="openColossus" data-colossus-id="{{this.id}}" title="Open">
          <i class="fas fa-eye"></i>
        </button>
        <button type="button" data-action="copyOpen" data-colossus-id="{{this.id}}" title="Copy open command">
          <i class="fas fa-copy"></i>
        </button>
        <button type="button" data-action="deleteColossus" data-colossus-id="{{this.id}}" title="Delete">
          <i class="fas fa-trash"></i>
        </button>
      </div>
    </li>
    {{/each}}
  </ol>
  {{else}}
  <p class="empty-state">No colossi created yet.</p>
  {{/if}}
</section>
